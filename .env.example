# Geen secrets: run setup om ze lokaal te genereren.
# Zet UID/GID gelijk aan de eigenaar van ./data en ./secrets (id -u; id -g).
LOCAL_UID=1000
LOCAL_GID=1000
APP_PORT=3000
APP_ORIGIN=http://127.0.0.1:3000
# Voorlopige instelbare resource/securitygrenzen, geen goedgekeurde gebruikersnormen.
SESSION_MS=28800000
MAX_MESSAGE_BYTES=2097152
INBOX_PAGE_SIZE=50
MAIL_TIMEOUT_MS=10000
LOGIN_ATTEMPTS_PER_MINUTE=10
BODY_LIMIT_BYTES=262144
MAX_DRAFT_CHARS=200000
SQLITE_BUSY_MS=5000
