myhostname = mail.example.test
mydomain = example.test
myorigin = $mydomain
inet_interfaces = all
inet_protocols = ipv4
mydestination = localhost
mynetworks = 127.0.0.0/8
virtual_mailbox_domains = example.test
virtual_mailbox_maps = hash:/etc/postfix/virtual-recipients
virtual_transport = lmtp:unix:private/dovecot-lmtp
smtpd_sasl_type = dovecot
smtpd_sasl_path = private/auth
smtpd_sasl_auth_enable = yes
smtpd_tls_cert_file = /run/test-secrets/mail.crt
smtpd_tls_key_file = /run/test-secrets/mail.key
smtpd_tls_security_level = encrypt
smtpd_tls_auth_only = yes
smtpd_tls_mandatory_protocols = >=TLSv1.2
smtpd_relay_restrictions = reject_unauth_destination
smtpd_recipient_restrictions = reject_unauth_destination, permit_sasl_authenticated, reject
# Even authenticated users can only deliver to the two mapped synthetic addresses.
default_transport = error:External delivery disabled
relay_transport = error:External relay disabled
maillog_file = /dev/stdout
smtpd_banner = $myhostname ESMTP isolated synthetic fixture
